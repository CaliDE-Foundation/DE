# Maintainer: CaliDE Foundation
# Cali builds with Zig 0.13 exactly (newer Zig changed its build API), so
# this fetches that Zig for the build instead of using Arch's.
pkgname=calide-git
pkgver=r0
pkgrel=1
pkgdesc="Cali: a desktop that feels like GNOME and lets you make it yours"
arch=(x86_64)
url="https://github.com/CaliDE-Foundation/DE"
license=(GPL-3.0-or-later)
depends=(sookie dbus glib2 gtk4 libadwaita pam pipewire wireplumber
         xdg-desktop-portal xdg-desktop-portal-gnome xdg-desktop-portal-gtk)
optdepends=('networkmanager: Wi-Fi and network status'
            'bluez: Bluetooth'
            'upower: battery status'
            'orca: screen reader'
            'mate-polkit: password prompts for admin tasks'
            'python-gobject: the bundled CPU Monitor extension')
makedepends=(git rust go)
provides=(calide)
conflicts=(calide)
source=("git+https://github.com/CaliDE-Foundation/DE.git"
        "https://ziglang.org/download/0.13.0/zig-linux-x86_64-0.13.0.tar.xz")
sha256sums=(SKIP
            d45312e61ebcc48032b77bc4cf7fd6915c11fa16e4aad116b66c9468211230ea)

pkgver() {
  cd DE
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  export PATH="$srcdir/zig-linux-x86_64-0.13.0:$PATH"
  cd DE
  make NICE= JOBS="$(nproc)" compositor-sookie services settings-app
}

package() {
  cd DE
  make install PREFIX=/usr DESTDIR="$pkgdir"
}
